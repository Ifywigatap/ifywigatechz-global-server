# =================================================
# == IFYWIGATECHZ API - ENVIRONMENT VARIABLES    ==
# =================================================
#
# Copy this file to .env and fill in the values.
# Do NOT commit the .env file to version control.

# --- Application Settings ---
# 'development' or 'production'
NODE_ENV=development
# Port the server will run on
PORT=5000

# --- Database ---
# Your MongoDB connection string from Atlas or local instance
MONGODB_URI=mongodb://localhost:27017/ifywigatechz
# Optional: Number of times to retry DB connection on startup
MONGODB_CONNECT_RETRIES=5

# --- Security & Authentication ---
# A long, random, and secret string for signing JWTs
JWT_SECRET=your_super_secret_jwt_string_that_is_very_long
# How long the JWT access token should be valid for (e.g., 15m, 1h, 7d)
JWT_EXPIRE=15m
# The frontend URL(s) allowed to make requests. Comma-separated for multiple domains.
CORS_ORIGIN=http://localhost:5173
# Optional: For production, if your frontend and backend are on different subdomains of the same parent domain (e.g., api.example.com and app.example.com), set this to 'example.com'
# COOKIE_DOMAIN=yourdomain.com

# --- External Services ---

# Paystack (for payments)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (for image and video storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sentry (for error tracking)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000

# Groq (for AI Chat)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend ---
# The base URL of your frontend application (used by Paystack and CORS fallback)
VITE_FRONTEND_URL=http://localhost:5173