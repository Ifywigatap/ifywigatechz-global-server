# Example environment file for local development.
# Copy this to `.env` and fill in real values. Do NOT commit your real `.env` to git.

# MongoDB
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster0.example.mongodb.net/<DB_NAME>

# Server
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=15m

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (example)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace_with_smtp_password

# Payment provider (example)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
